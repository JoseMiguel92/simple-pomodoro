{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"]
      },
      "firefox-devtools": {
        "type": "local",
        "command": ["npx", "-y", "@mozilla/firefox-devtools-mcp@latest"]
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    }
  },
  "plugins": ["openslimedit@latest", "opencode-dcp@latest"]
}
