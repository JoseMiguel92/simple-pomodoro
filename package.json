{
  "name": "simple-pomodoro",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:coverage": "ng test --no-watch --coverage",
    "test:run": "ng test --no-watch",
    "verify": "echo Format check... && npm run format:check && echo Lint... && npm run lint && echo Tests... && npm run test:run"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*": "prettier --check --write --ignore-unknown",
    "*.ts": "eslint --fix"
  }
}
